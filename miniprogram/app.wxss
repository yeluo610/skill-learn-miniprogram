page {
  background: #f5f5f5;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}
view, text, button, input, textarea {
  box-sizing: border-box;
}
.container {
  padding: 24rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.btn-primary {
  background: #4f46e5;
  color: #fff;
  border-radius: 12rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 30rpx;
}
.btn-primary[disabled] {
  background: #c7d2fe;
}
.btn-ghost {
  background: #fff;
  color: #4f46e5;
  border: 1rpx solid #4f46e5;
  border-radius: 12rpx;
  padding: 20rpx 0;
  text-align: center;
}
.text-muted { color: #888; font-size: 24rpx; }
.text-primary { color: #4f46e5; }
.title-lg { font-size: 36rpx; font-weight: 600; }
.title-md { font-size: 32rpx; font-weight: 600; }
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.progress-bar {
  height: 12rpx;
  background: #e5e7eb;
  border-radius: 6rpx;
  overflow: hidden;
}
.progress-bar > .fill {
  height: 100%;
  background: #4f46e5;
  border-radius: 6rpx;
  transition: width 0.3s;
}
