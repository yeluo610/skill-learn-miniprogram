.header {
  text-align: center;
  padding: 40rpx 24rpx;
}
.section-title {
  font-size: 28rpx;
  color: #888;
  padding: 12rpx 8rpx;
  margin-top: 10rpx;
}
.skill-list { display: flex; flex-direction: column; gap: 20rpx; }
.skill-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
}
.skill-icon {
  width: 80rpx; height: 80rpx;
  border-radius: 16rpx;
  background: #eef2ff;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
}
.skill-body { flex: 1; }
.skill-body .progress-bar { margin-top: 12rpx; }
.arrow { font-size: 40rpx; color: #ccc; padding-left: 16rpx; }
