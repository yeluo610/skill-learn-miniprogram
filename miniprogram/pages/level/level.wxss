.list-meta {
  font-size: 22rpx;
  color: #8a8f99;
  padding: 4rpx 4rpx 12rpx;
}
.q-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.q-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 18rpx 16rpx;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.03);
}
.q-item-left {
  margin-right: 16rpx;
  flex-shrink: 0;
}
.q-num {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: #f3f4f6;
  color: #6b7280;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 600;
}
.q-item-body {
  flex: 1;
  min-width: 0;
}
.q-title {
  font-size: 26rpx;
  color: #1f2329;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.q-tags {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
}
.q-arrow {
  color: #d1d5db;
  font-size: 32rpx;
  padding-left: 8rpx;
  flex-shrink: 0;
}
