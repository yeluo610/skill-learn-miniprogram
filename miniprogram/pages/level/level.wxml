<view class="container">
  <view class="list-meta">共 {{total}} 题</view>
  <view class="q-list">
    <block wx:for="{{list}}" wx:key="id">
      <view class="q-item" bindtap="goQuestion" data-idx="{{index}}">
        <view class="q-item-left">
          <view class="q-num">{{index + 1}}</view>
        </view>
        <view class="q-item-body">
          <view class="q-title">{{item.title}}</view>
          <view class="q-tags">
            <text class="tag {{item.type === 'choice' ? 'tag-indigo' : 'tag-amber'}}">{{item.type === 'choice' ? '选择' : '填空'}}</text>
            <text class="tag tag-green" wx:if="{{progress[item.id] === 'correct'}}">已掌握</text>
            <text class="tag tag-red" wx:elif="{{progress[item.id] === 'wrong'}}">待复习</text>
          </view>
        </view>
        <view class="q-arrow">›</view>
      </view>
    </block>
  </view>
  <view class="loading-text" wx:if="{{loading}}">加载中...</view>
  <view class="loading-text" wx:if="{{!loading && list.length >= total && total > 0}}">已经到底了</view>
</view>
