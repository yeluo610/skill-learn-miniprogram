<view class="container">
  <view class="score-card">
    <view class="score-num">{{score}}<text class="score-total">/{{total}}</text></view>
    <view class="score-label">本次得分</view>
    <view class="score-rate">正确率 {{total ? Math.round(score / total * 100) : 0}}%</view>
  </view>

  <view class="section-title">逐题解析（{{details.length}} 题）</view>
  <block wx:for="{{details}}" wx:key="questionId" wx:for-index="i">
    <view class="detail-item {{item.correct ? 'ok' : 'err'}}">
      <view class="detail-head" bindtap="toggle" data-idx="{{i}}">
        <text class="detail-num">第 {{i + 1}} 题</text>
        <text class="detail-status">{{item.correct ? '✓ 正确' : '✗ 错误'}}</text>
        <text class="detail-arrow">{{expanded === i ? '▾' : '▸'}}</text>
      </view>
      <view class="detail-body" wx:if="{{expanded === i}}">
        <view class="d-q">{{item.question.title}}</view>
        <view class="d-row">
          <text class="d-label">你的答案：</text>
          <text class="d-val">{{item.userAnswer === undefined ? '未作答' : (item.question.type === 'choice' ? ['A','B','C','D'][item.userAnswer] : item.userAnswer)}}</text>
        </view>
        <view class="d-row" wx:if="{{item.question.type === 'choice'}}">
          <text class="d-label">正确答案：</text>
          <text class="d-val text-primary">{{['A','B','C','D'][item.correctAnswer]}}</text>
        </view>
        <view class="d-row" wx:if="{{item.question.type === 'fill' && item.referenceAnswer}}">
          <text class="d-label">参考答案：</text>
          <text class="d-val text-primary">{{item.referenceAnswer}}</text>
        </view>
        <view class="d-exp">{{item.explanation}}</view>
      </view>
    </view>
  </block>
</view>
