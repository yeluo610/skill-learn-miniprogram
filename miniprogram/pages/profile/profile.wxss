.user-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 14rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 8rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
}
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #e5e7eb;
}
.avatar.ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.user-info { flex: 1; }
.user-name { font-size: 30rpx; font-weight: 600; color: #1f2329; }
.user-sub { font-size: 22rpx; color: #8a8f99; margin-top: 4rpx; }

.login-card {
  background: #fff;
  border-radius: 14rpx;
  padding: 36rpx 24rpx;
  margin-bottom: 8rpx;
  text-align: center;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
}
.lc-title { font-size: 30rpx; font-weight: 600; color: #1f2329; }
.lc-sub { font-size: 22rpx; color: #8a8f99; margin-top: 6rpx; }
.lc-btn { margin-top: 24rpx; }

.skill-summary {
  background: #fff;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 10rpx;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.03);
}
.ss-name { font-size: 28rpx; font-weight: 600; color: #1f2329; }
.ss-num { font-size: 26rpx; color: #4f46e5; font-weight: 600; }
.ss-meta { font-size: 22rpx; color: #8a8f99; margin-top: 8rpx; }

.about-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 12rpx;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.03);
}
.ab-title { font-size: 28rpx; font-weight: 600; color: #1f2329; }
.ab-text { font-size: 24rpx; color: #6b7280; margin-top: 10rpx; line-height: 1.7; }
