.user-card { display: flex; align-items: center; padding: 32rpx 24rpx; }
.avatar { width: 96rpx; height: 96rpx; border-radius: 50%; margin-right: 24rpx; background: #e5e7eb; }
.avatar.placeholder { display: flex; align-items: center; justify-content: center; font-size: 48rpx; }
.user-info { flex: 1; }
.login-card { text-align: center; padding: 40rpx 24rpx; }
.section-title { font-size: 28rpx; color: #888; padding: 16rpx 8rpx; }
.skill-summary { padding: 24rpx; }
.about { padding: 24rpx; margin-top: 20rpx; }
.about .text-muted { margin-top: 12rpx; line-height: 1.7; }
