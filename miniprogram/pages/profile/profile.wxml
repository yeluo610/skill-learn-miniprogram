<view class="container">
  <view class="user-card" wx:if="{{loggedIn}}">
    <image class="avatar" src="{{avatarUrl}}" wx:if="{{avatarUrl}}" mode="aspectFill"></image>
    <view class="avatar ph" wx:else>👤</view>
    <view class="user-info">
      <view class="user-name">{{nickname || '已登录'}}</view>
      <view class="user-sub">微信已登录</view>
    </view>
  </view>

  <view class="login-card" wx:else>
    <view class="lc-title">登录后同步进度</view>
    <view class="lc-sub">使用微信登录，进度自动云端保存</view>
    <button class="btn-primary lc-btn" bindtap="login">微信登录</button>
  </view>

  <view class="section-title" wx:if="{{loggedIn}}">学习总览</view>
  <block wx:for="{{skills}}" wx:key="id" wx:if="{{loggedIn}}">
    <view class="skill-summary">
      <view class="row-between">
        <view class="ss-name">{{item.name}}</view>
        <view class="ss-num">{{item.correct}}/{{item.total}}</view>
      </view>
      <view class="progress-bar" style="margin-top: 10rpx;">
        <view class="fill" style="width: {{item.total ? item.correct / item.total * 100 : 0}}%"></view>
      </view>
      <view class="ss-meta">已练 {{item.attempted}} · 正确 {{item.correct}}</view>
    </view>
  </block>

  <view class="about-card">
    <view class="ab-title">关于</view>
    <view class="ab-text">技能学习小程序 · 通过关卡、考试、错题、教程系统掌握命令与语法。首期：正则、JSONPath；后续：Linux、kubectl。</view>
  </view>
</view>
