.q-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 22rpx 20rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
}
.q-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}
.q-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.55;
}
.q-content {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.6;
}

.testcases {
  margin-top: 18rpx;
  padding: 14rpx;
  background: #f9fafb;
  border-radius: 10rpx;
  border: 1rpx solid #f3f4f6;
}
.tc-title {
  font-size: 22rpx;
  color: #8a8f99;
  margin-bottom: 8rpx;
}
.tc-item {
  padding: 8rpx 0;
  border-top: 1rpx dashed #e5e7eb;
}
.tc-item:first-of-type { border-top: 0; }
.tc-row {
  display: flex;
  font-size: 24rpx;
  line-height: 1.5;
}
.tc-key {
  width: 70rpx;
  color: #8a8f99;
  flex-shrink: 0;
}
.tc-val {
  flex: 1;
  word-break: break-all;
  font-family: Consolas, Monaco, monospace;
  color: #1f2329;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 14rpx;
}
.option {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 18rpx 16rpx;
  border-radius: 12rpx;
  border: 2rpx solid #eef0f3;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.03);
}
.option.sel { border-color: #4f46e5; background: #eef2ff; }
.option.ok { border-color: #16a34a; background: #f0fdf4; }
.option.err { border-color: #dc2626; background: #fef2f2; }
.opt-letter {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: #f3f4f6;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.option.sel .opt-letter { background: #4f46e5; color: #fff; }
.option.ok .opt-letter { background: #16a34a; color: #fff; }
.opt-text {
  flex: 1;
  font-size: 26rpx;
  color: #1f2329;
  line-height: 1.5;
}

.fill-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
}
.fill-label {
  font-size: 22rpx;
  color: #8a8f99;
  margin-bottom: 10rpx;
}
.fill-input {
  width: 100%;
  min-height: 100rpx;
  padding: 16rpx;
  background: #f9fafb;
  border-radius: 10rpx;
  font-size: 26rpx;
  font-family: Consolas, Monaco, monospace;
  color: #1f2329;
  border: 1rpx solid #eef0f3;
}
.fill-ph { color: #c7c7cc; }

.check-result {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f3f4f6;
}
.cr-title {
  font-size: 22rpx;
  color: #8a8f99;
  margin-bottom: 8rpx;
}
.cr-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 6rpx 0;
  font-size: 24rpx;
}
.cr-item.ok { color: #16a34a; }
.cr-item.err { color: #dc2626; }
.cr-mark { font-weight: 700; }
.cr-text { flex: 1; word-break: break-all; }

.explanation {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 14rpx;
  border-left: 6rpx solid #e5e7eb;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
}
.explanation.ok { border-left-color: #16a34a; }
.explanation.err { border-left-color: #dc2626; }
.exp-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
}
.exp-icon {
  font-size: 30rpx;
  font-weight: 700;
}
.explanation.ok .exp-icon { color: #16a34a; }
.explanation.err .exp-icon { color: #dc2626; }
.exp-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
}
.exp-answer {
  margin: 10rpx 0;
  font-size: 26rpx;
}
.exp-label {
  color: #8a8f99;
  font-size: 24rpx;
}
.exp-body {
  margin-top: 14rpx;
  padding: 14rpx;
  background: #f9fafb;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #374151;
  line-height: 1.7;
}

.actions {
  margin-top: 16rpx;
  padding-bottom: 40rpx;
}
