<view class="container" wx:if="{{!loading && question}}">
  <view class="q-card">
    <view class="q-tags">
      <text class="tag {{question.type === 'choice' ? 'tag-indigo' : 'tag-amber'}}">{{question.type === 'choice' ? '选择题' : '填空题'}}</text>
      <text class="text-muted" wx:if="{{question.hint}}">💡 {{question.hint}}</text>
    </view>
    <view class="q-title">{{question.title}}</view>
    <view class="q-content" wx:if="{{question.content}}">{{question.content}}</view>

    <view class="testcases" wx:if="{{question.type === 'fill' && question.testCases.length}}">
      <view class="tc-title">测试用例</view>
      <block wx:for="{{question.testCases}}" wx:key="index" wx:for-item="tc">
        <view class="tc-item">
          <view class="tc-row"><text class="tc-key">输入</text><text class="tc-val">{{tc.input}}</text></view>
          <view class="tc-row"><text class="tc-key">期望</text><text class="tc-val">{{tc.expected}}</text></view>
        </view>
      </block>
    </view>
  </view>

  <!-- 选择题 -->
  <view class="options" wx:if="{{question.type === 'choice'}}">
    <block wx:for="{{question.options}}" wx:key="index">
      <view
        class="option {{selected === index ? 'sel' : ''}} {{submitted && index === correctAnswer ? 'ok' : ''}} {{submitted && selected === index && index !== correctAnswer ? 'err' : ''}}"
        bindtap="onSelect" data-idx="{{index}}">
        <text class="opt-letter">{{['A','B','C','D'][index]}}</text>
        <text class="opt-text">{{item}}</text>
      </view>
    </block>
  </view>

  <!-- 填空题 -->
  <view class="fill-card" wx:if="{{question.type === 'fill'}}">
    <view class="fill-label">输入你的答案</view>
    <textarea
      class="fill-input"
      value="{{userInput}}"
      bindinput="onInput"
      placeholder="在此输入..."
      placeholder-class="fill-ph"
      disabled="{{submitted}}"
      auto-height
    />
    <view class="check-result" wx:if="{{submitted && checkResult}}">
      <view class="cr-title">校验详情</view>
      <block wx:for="{{checkResult.details}}" wx:key="index">
        <view class="cr-item {{item.pass ? 'ok' : 'err'}}">
          <text class="cr-mark">{{item.pass ? '✓' : '✗'}}</text>
          <text class="cr-text">实际: {{item.got}} · 期望: {{item.expected}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 解析 -->
  <view class="explanation {{correct ? 'ok' : 'err'}}" wx:if="{{submitted}}">
    <view class="exp-head">
      <text class="exp-icon">{{correct ? '✓' : '✗'}}</text>
      <text class="exp-title">{{correct ? '回答正确' : '回答错误'}}</text>
    </view>
    <view class="exp-answer" wx:if="{{question.type === 'fill' && referenceAnswer}}">
      <text class="exp-label">参考答案：</text><text class="text-primary">{{referenceAnswer}}</text>
    </view>
    <view class="exp-answer" wx:if="{{question.type === 'choice'}}">
      <text class="exp-label">正确答案：</text><text class="text-primary">{{['A','B','C','D'][correctAnswer]}}</text>
    </view>
    <view class="exp-body">{{explanation}}</view>
  </view>

  <view class="actions">
    <button class="btn-primary" wx:if="{{!submitted}}" bindtap="onSubmit">提交</button>
    <button class="btn-ghost" wx:if="{{submitted}}" bindtap="goNext">返回列表</button>
  </view>
</view>

<view class="loading-text" wx:if="{{loading}}">加载中...</view>
