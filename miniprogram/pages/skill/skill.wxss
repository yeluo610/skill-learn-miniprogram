.quick-grid {
  display: flex;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.quick-cell {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 22rpx 0;
  text-align: center;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
}
.qc-icon {
  font-size: 40rpx;
  line-height: 1;
}
.qc-label {
  font-size: 22rpx;
  color: #4b5563;
  margin-top: 6rpx;
}

.level-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.level-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
}
.level-head {
  margin-bottom: 14rpx;
}
.level-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
}
.level-desc {
  font-size: 22rpx;
  color: #8a8f99;
  margin-top: 4rpx;
  line-height: 1.4;
}
.level-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.level-stats .progress-bar {
  flex: 1;
}
.level-stats-text {
  font-size: 22rpx;
  flex-shrink: 0;
  white-space: nowrap;
}
