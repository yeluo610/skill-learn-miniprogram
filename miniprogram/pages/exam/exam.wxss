.head { text-align: center; padding: 30rpx; }
.section-title { font-size: 28rpx; color: #888; padding: 16rpx 8rpx; }
.exam-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.exam-cell {
  width: calc(33.333% - 14rpx);
  background: #fff; border-radius: 12rpx;
  padding: 30rpx 0; text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  font-size: 28rpx;
}
