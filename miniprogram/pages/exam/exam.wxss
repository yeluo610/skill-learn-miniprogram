.head-card {
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  color: #fff;
  border-radius: 14rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 8rpx;
}
.head-title {
  font-size: 32rpx;
  font-weight: 600;
}
.head-sub {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}
.exam-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.exam-cell {
  width: calc(25% - 10.5rpx);
  background: #fff;
  border-radius: 12rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #4f46e5;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
}
