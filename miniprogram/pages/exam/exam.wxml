<view class="container">
  <view class="head-card">
    <view class="head-title">{{skillName}} 考试</view>
    <view class="head-sub">每套 50 道随机题 · 考完即出分与解析</view>
  </view>
  <view class="section-title">选择试卷（共 20 套）</view>
  <view class="exam-grid">
    <block wx:for="{{examSets}}" wx:key="*this">
      <view class="exam-cell" bindtap="goExam" data-id="{{item}}">{{item}}</view>
    </block>
  </view>
</view>
