.exam-header { display: flex; justify-content: space-between; padding: 16rpx 8rpx; font-size: 26rpx; color: #666; }
.exam-progress { margin: 0 8rpx 20rpx; }
.tag { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 8rpx; display: inline-block; margin-bottom: 12rpx; }
.tag-choice { background: #e0e7ff; color: #4f46e5; }
.tag-fill { background: #fef3c7; color: #b45309; }
.q-card { padding: 24rpx; }
.q-title { font-size: 32rpx; font-weight: 600; line-height: 1.5; }
.q-content { margin-top: 12rpx; color: #555; }
.testcases { margin-top: 16rpx; padding: 16rpx; background: #f9fafb; border-radius: 12rpx; }
.tc-row { display: flex; padding: 6rpx 0; }
.tc-label { width: 80rpx; color: #888; font-size: 24rpx; flex-shrink: 0; }
.tc-value { flex: 1; word-break: break-all; font-family: monospace; }
.options { margin-top: 20rpx; }
.option { display: flex; align-items: center; padding: 20rpx; margin: 10rpx 0; border: 2rpx solid #e5e7eb; border-radius: 12rpx; }
.option.selected { border-color: #4f46e5; background: #eef2ff; }
.opt-letter { width: 48rpx; height: 48rpx; line-height: 48rpx; border-radius: 50%; background: #f3f4f6; text-align: center; margin-right: 20rpx; font-weight: 600; }
.option.selected .opt-letter { background: #4f46e5; color: #fff; }
.fill-area { margin-top: 20rpx; }
.fill-input { padding: 20rpx; background: #f9fafb; border-radius: 12rpx; min-height: 100rpx; width: 100%; font-family: monospace; }
.nav-btns { display: flex; gap: 20rpx; margin: 24rpx 0; }
.nav-btns button { flex: 1; }
.jump-grid { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 16rpx 0; }
.jump-cell { width: 60rpx; height: 60rpx; line-height: 60rpx; text-align: center; background: #f3f4f6; border-radius: 8rpx; font-size: 24rpx; }
.jump-cell.answered { background: #e0e7ff; color: #4f46e5; }
.jump-cell.current { border: 2rpx solid #4f46e5; }
.submit-btn { margin: 30rpx 0 60rpx; }
.loading-full { text-align: center; color: #aaa; padding: 100rpx; }
