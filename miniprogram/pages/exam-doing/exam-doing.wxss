.exam { padding-bottom: 40rpx; }
.exam-bar {
  display: flex;
  justify-content: space-between;
  padding: 4rpx 4rpx;
  font-size: 24rpx;
  color: #6b7280;
}
.eb-cur { color: #4f46e5; font-weight: 600; }
.exam-prog { margin: 8rpx 4rpx 16rpx; }

.q-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 22rpx 20rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
}
.q-card .tag { margin-bottom: 12rpx; }
.q-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.55;
}
.q-content {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #4b5563;
}

.testcases {
  margin-top: 16rpx;
  padding: 14rpx;
  background: #f9fafb;
  border-radius: 10rpx;
  border: 1rpx solid #f3f4f6;
}
.tc-title { font-size: 22rpx; color: #8a8f99; margin-bottom: 8rpx; }
.tc-row { display: flex; padding: 4rpx 0; font-size: 24rpx; }
.tc-key { width: 70rpx; color: #8a8f99; flex-shrink: 0; }
.tc-val { flex: 1; word-break: break-all; font-family: Consolas, Monaco, monospace; }

.options { margin-top: 18rpx; display: flex; flex-direction: column; gap: 10rpx; }
.option {
  display: flex;
  align-items: center;
  padding: 16rpx;
  border: 2rpx solid #eef0f3;
  border-radius: 10rpx;
}
.option.sel { border-color: #4f46e5; background: #eef2ff; }
.opt-letter {
  width: 44rpx; height: 44rpx; line-height: 44rpx;
  text-align: center; border-radius: 50%;
  background: #f3f4f6; color: #6b7280;
  font-size: 24rpx; font-weight: 600;
  margin-right: 16rpx; flex-shrink: 0;
}
.option.sel .opt-letter { background: #4f46e5; color: #fff; }
.opt-text { flex: 1; font-size: 26rpx; color: #1f2329; }

.fill-area { margin-top: 18rpx; }
.fill-input {
  width: 100%; min-height: 100rpx;
  padding: 16rpx;
  background: #f9fafb;
  border-radius: 10rpx;
  font-size: 26rpx;
  font-family: Consolas, Monaco, monospace;
  border: 1rpx solid #eef0f3;
}
.fill-ph { color: #c7c7cc; }

.nav-btns {
  display: flex;
  gap: 14rpx;
  margin: 18rpx 0;
}
.nb {
  flex: 1;
  margin: 0;
  padding: 14rpx 0;
  font-size: 26rpx;
  border-radius: 10rpx;
  background: #fff;
  color: #4f46e5;
  border: 1rpx solid #4f46e5;
  line-height: 1.4;
}
.nb[disabled] { color: #c7c7cc; border-color: #e5e7eb; background: #f9fafb; }

.jump-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding: 14rpx 0;
}
.jump-cell {
  width: 52rpx; height: 52rpx; line-height: 52rpx;
  text-align: center;
  background: #f3f4f6;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #6b7280;
}
.jump-cell.done { background: #e0e7ff; color: #4f46e5; }
.jump-cell.cur { border: 2rpx solid #4f46e5; line-height: 48rpx; }

.submit-btn { margin: 16rpx 0 0; }
