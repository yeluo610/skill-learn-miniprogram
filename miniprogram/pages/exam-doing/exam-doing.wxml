<view class="container exam" wx:if="{{!loading}}">
  <view class="exam-bar">
    <text class="eb-cur">第 {{current + 1}} / {{questions.length}} 题</text>
    <text class="eb-answered">已答 {{answeredCount}}</text>
  </view>
  <view class="progress-bar exam-prog">
    <view class="fill" style="width: {{(current + 1) / questions.length * 100}}%"></view>
  </view>

  <block wx:for="{{questions}}" wx:key="id" wx:for-index="i">
    <view class="q-card" wx:if="{{i === current}}">
      <text class="tag {{item.type === 'choice' ? 'tag-indigo' : 'tag-amber'}}">{{item.type === 'choice' ? '选择' : '填空'}}</text>
      <view class="q-title">{{item.title}}</view>
      <view class="q-content" wx:if="{{item.content}}">{{item.content}}</view>

      <view class="testcases" wx:if="{{item.type === 'fill' && item.testCases.length}}">
        <view class="tc-title">测试用例</view>
        <block wx:for="{{item.testCases}}" wx:key="index" wx:for-item="tc">
          <view class="tc-row"><text class="tc-key">输入</text><text class="tc-val">{{tc.input}}</text></view>
          <view class="tc-row"><text class="tc-key">期望</text><text class="tc-val">{{tc.expected}}</text></view>
        </block>
      </view>

      <view class="options" wx:if="{{item.type === 'choice'}}">
        <block wx:for="{{item.options}}" wx:key="index" wx:for-item="opt">
          <view class="option {{answers[item.id] === index ? 'sel' : ''}}" bindtap="onSelect" data-idx="{{index}}">
            <text class="opt-letter">{{['A','B','C','D'][index]}}</text>
            <text class="opt-text">{{opt}}</text>
          </view>
        </block>
      </view>

      <view class="fill-area" wx:if="{{item.type === 'fill'}}">
        <textarea class="fill-input" value="{{answers[item.id]}}" bindinput="onInput" placeholder="输入答案" placeholder-class="fill-ph" auto-height />
      </view>
    </view>
  </block>

  <view class="nav-btns">
    <button class="nb" bindtap="prev" disabled="{{current === 0}}">上一题</button>
    <button class="nb" bindtap="next" disabled="{{current === questions.length - 1}}">下一题</button>
  </view>

  <view class="jump-grid">
    <block wx:for="{{questions}}" wx:key="id" wx:for-index="i">
      <view class="jump-cell {{answers[item.id] !== undefined ? 'done' : ''}} {{i === current ? 'cur' : ''}}"
            bindtap="goJump" data-idx="{{i}}">{{i + 1}}</view>
    </block>
  </view>

  <button class="btn-primary submit-btn" bindtap="onSubmitTap" loading="{{submitting}}">交卷</button>
</view>

<view class="loading-text" wx:if="{{loading}}">出卷中...</view>

<!-- 确认交卷弹层 -->
<view class="modal-mask" wx:if="{{showConfirm}}" bindtap="cancelSubmit">
  <view class="modal-card" catchtap="">
    <view class="modal-icon">⚠️</view>
    <view class="modal-title">确认交卷？</view>
    <view class="modal-content">还有 {{unansweredCount}} 题未作答，交卷后将无法修改。</view>
    <view class="modal-actions">
      <button class="modal-btn ghost" bindtap="cancelSubmit">再想想</button>
      <button class="modal-btn primary" bindtap="confirmSubmit">确认交卷</button>
    </view>
  </view>
</view>

<!-- 错误提示弹层 -->
<view class="modal-mask" wx:if="{{showError}}" bindtap="closeError">
  <view class="modal-card" catchtap="">
    <view class="modal-icon err">⚠️</view>
    <view class="modal-title">出错了</view>
    <view class="modal-content">{{errorMsg}}</view>
    <view class="modal-actions">
      <button class="modal-btn primary" bindtap="closeError">知道了</button>
    </view>
  </view>
</view>
