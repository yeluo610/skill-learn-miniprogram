.tutorial { display: flex; height: 100vh; }
.toc { width: 220rpx; background: #fff; border-right: 1rpx solid #e5e7eb; }
.toc-item { padding: 24rpx; font-size: 26rpx; border-bottom: 1rpx solid #f3f4f6; }
.toc-item.active { background: #eef2ff; color: #4f46e5; font-weight: 600; }
.content { flex: 1; display: flex; flex-direction: column; }
.content-scroll { flex: 1; }
.content-inner { padding: 32rpx; }
.title-lg { font-size: 36rpx; font-weight: 700; margin-bottom: 24rpx; }
.md { font-size: 28rpx; line-height: 1.8; color: #333; white-space: pre-wrap; }
.content-nav { display: flex; gap: 20rpx; padding: 20rpx; }
.content-nav button { flex: 1; }
