/* 教程页：左目录 + 右内容，高度适配 tabBar */
page { height: 100%; overflow: hidden; }
.tutorial {
  display: flex;
  height: 100vh;
  box-sizing: border-box;
}

/* 左侧目录 */
.toc {
  width: 200rpx;
  height: 100%;
  background: #fff;
  border-right: 1rpx solid #e5e7eb;
  flex-shrink: 0;
}
.toc-item {
  padding: 24rpx 20rpx;
  font-size: 24rpx;
  color: #555;
  border-bottom: 1rpx solid #f3f4f6;
  line-height: 1.4;
}
.toc-item.active {
  background: #eef2ff;
  color: #4f46e5;
  font-weight: 600;
  border-left: 6rpx solid #4f46e5;
}

/* 右侧内容 */
.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  height: 100%;
}
.content-scroll {
  flex: 1;
  min-height: 0;
}
.content-inner {
  padding: 28rpx 32rpx 48rpx;
}

/* Markdown 渲染 */
.doc-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #e5e7eb;
}
.md-h1 { font-size: 36rpx; font-weight: 700; color: #1f2937; margin: 32rpx 0 16rpx; }
.md-h2 { font-size: 32rpx; font-weight: 600; color: #374151; margin: 28rpx 0 14rpx; }
.md-h3 { font-size: 28rpx; font-weight: 600; color: #4b5563; margin: 22rpx 0 12rpx; }
.md-p { font-size: 28rpx; color: #374151; line-height: 1.8; margin: 12rpx 0; }

.md-code {
  margin: 20rpx 0;
  background: #1f2937;
  border-radius: 12rpx;
  overflow: hidden;
}
.md-code-lang {
  padding: 12rpx 20rpx;
  font-size: 22rpx;
  color: #9ca3af;
  background: #111827;
  border-bottom: 1rpx solid #374151;
}
.md-code-text {
  display: block;
  padding: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #e5e7eb;
  font-family: Consolas, Monaco, monospace;
  white-space: pre;
  overflow-x: auto;
}

.md-ul, .md-ol { margin: 14rpx 0; padding-left: 8rpx; }
.md-li {
  display: flex;
  align-items: flex-start;
  padding: 6rpx 0;
  font-size: 28rpx;
  color: #374151;
  line-height: 1.7;
}
.md-bullet {
  width: 36rpx;
  flex-shrink: 0;
  color: #4f46e5;
  font-weight: 600;
}
.md-li-text { flex: 1; }

.md-table-wrap { margin: 20rpx 0; overflow-x: auto; }
.md-table { width: 100%; border-collapse: collapse; min-width: 100%; }
.md-tr { display: flex; border-bottom: 1rpx solid #e5e7eb; }
.md-thead { background: #f9fafb; }
.md-th, .md-td {
  flex: 1;
  padding: 14rpx 16rpx;
  font-size: 26rpx;
  min-width: 0;
  word-break: break-all;
}
.md-th { color: #374151; font-weight: 600; }
.md-td { color: #4b5563; }

.md-hr { height: 1rpx; background: #e5e7eb; margin: 28rpx 0; }

/* 底部导航按钮 */
.content-nav {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e5e7eb;
  flex-shrink: 0;
}
.nav-btn {
  flex: 1;
  margin: 0;
  padding: 18rpx 0;
  font-size: 28rpx;
  line-height: 1.4;
  border-radius: 10rpx;
  background: #fff;
  color: #4f46e5;
  border: 1rpx solid #4f46e5;
}
.nav-btn.disabled {
  color: #c7c7cc;
  border-color: #e5e7eb;
  background: #f9fafb;
}
.nav-btn[disabled] { color: #c7c7cc; border-color: #e5e7eb; background: #f9fafb; }
