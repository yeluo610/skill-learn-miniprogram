    "title": "找出 books 中标题以 'A' 开头的书。",
    "hint": "过滤用 =~ /^A/",
    "testCases": [
      { "input": "{\"books\":[{\"title\":\"Apple\"},{\"title\":\"Banana\"},{\"title\":\"Apricot\"}]}", "expected": ["{\"title\":\"Apple\"}", "{\"title\":\"Apricot\"}"], "expectedType": "equal" }
