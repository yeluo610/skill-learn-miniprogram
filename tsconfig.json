{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@miniprogram/*": ["miniprogram/*"],
      "@cloud/*": ["cloudfunctions/*"],
      "@data/*": ["data/*"],
      "@shared/*": ["miniprogram/shared/*"]
    },
    "typeRoots": ["./node_modules/@types", "./miniprogram/types"]
  },
  "include": [
    "miniprogram/**/*.ts",
    "cloudfunctions/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
